{
  "name": "custom-technology-software-development",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Keep the workers.dev address and the per-branch preview links working alongside the custom domain.
  // (Adding custom domains otherwise switches both off.)
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/assets/*", "!/images/*", "!/fonts/*", "!/data/*"]
  },
  "vars": {
    "LEAD_EMAIL": "amanorsac@gmail.com",
    "SUPABASE_URL": "https://bmqvkjgqicmatloztpcz.supabase.co",
    "MAIL_FROM": "",
    // The public address, e.g. "https://www.example.com". When set, canonical links, share URLs,
    // the sitemap and robots.txt use it instead of the address the request arrived on. Empty = request address.
    "SITE_ORIGIN": "https://ctsdstudio.com",
    // Virtual Assistant: the owner's Stripe Payment Link for the $499 setup fee (https://buy.stripe.com/...).
    // Not a secret. Empty = sign-ups go straight to the welcome page.
    "VA_SETUP_LINK": "",
    // Back office (/admin). Secrets STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and ADELAIDE_ADMIN_KEY are set with
    // `wrangler secret put`, never here. ACCESS_TEAM and ACCESS_AUD come from the Cloudflare Access app (docs/back-office-setup.md).
    "ADELAIDE_BASE": "https://virtual-assistant-adeliade.amanorsac.workers.dev",
    "ACCESS_TEAM": "",
    "ACCESS_AUD": ""
  },
  // Every hour: report each live restaurant's new minutes to Stripe.
  "triggers": { "crons": ["0 * * * *"] },
  // The real domain. Both names must be on this Cloudflare account before this deploys,
  // or the deploy fails. www forwards to the bare domain (src/worker.js).
  "routes": [
    { "pattern": "ctsdstudio.com", "custom_domain": true },
    { "pattern": "www.ctsdstudio.com", "custom_domain": true }
  ],
  // Branch and pull-request previews (Cloudflare Worker Previews).
  // SUPABASE_URL stays empty so previews never write leads into the
  // production database; their forms show the email fallback instead.
  "previews": {
    "vars": {
      "LEAD_EMAIL": "amanorsac@gmail.com",
      "SUPABASE_URL": "",
      "MAIL_FROM": "",
      "SITE_ORIGIN": "",
      "VA_SETUP_LINK": "",
      "ADELAIDE_BASE": "",
      "ACCESS_TEAM": "",
      "ACCESS_AUD": ""
    }
  }
}
